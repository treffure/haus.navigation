<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Indoor Navigation Mockup</title>
    <!-- A-Frame Bibliothek laden -->
    <script src="https://aframe.io"></script>
    <style>
        /* Grundlegendes Reset und Fullscreen */
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #000;
        }

        /* Video-Hintergrund für die echte Handykamera */
        #camera-stream {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        /* 3D-Szene transparent über das Kamerabild legen */
        a-scene {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
        }

        /* Stylisches UI Overlay */
        .ui-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 3;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(10, 10, 15, 0.6);
            backdrop-filter: blur(8px);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .ui-container.hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(1.1);
        }

        h1 {
            color: #fff;
            font-size: 2rem;
            margin-bottom: 2rem;
            text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
            letter-spacing: 2px;
            text-align: center;
            animation: pulseText 2s infinite alternate;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            width: 80%;
            max-width: 300px;
        }

        /* Neon-animierte Buttons */
        .nav-btn {
            background: linear-gradient(135deg, rgba(0, 229, 255, 0.2), rgba(0, 78, 255, 0.2));
            color: #fff;
            border: 2px solid #00e5ff;
            padding: 1rem 2rem;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.2), inset 0 0 15px rgba(0, 229, 255, 0.1);
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-btn:active {
            transform: scale(0.95);
            background: rgba(0, 229, 255, 0.4);
            box-shadow: 0 0 25px #00e5ff;
        }

        /* UI Reset-Button (erscheint nach Auswahl oben rechts) */
        #reset-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 4;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            display: none;
            backdrop-filter: blur(5px);
        }

        /* CSS Animationen */
        @keyframes pulseText {
            from { text-shadow: 0 0 10px rgba(0, 229, 255, 0.5); }
            to { text-shadow: 0 0 20px rgba(0, 229, 255, 0.9), 0 0 30px rgba(0, 78, 255, 0.6); }
        }
    </style>
</head>
<body>

    <!-- 1. Live-Kamerabild als realer Hintergrund -->
    <video id="camera-stream" autoplay playsinline muted></video>

    <!-- 2. UI Overlay Menü -->
    <div class="ui-container" id="menu-overlay">
        <h1>WO WILLST DU HIN?</h1>
        <div class="btn-group">
            <button class="nav-btn" onclick="startNavigation('kueche')">Küche</button>
            <button class="nav-btn" onclick="startNavigation('bad')">Bad</button>
        </div>
    </div>

    <button id="reset-btn" onclick="resetNavigation()">🔄 Menü</button>

    <!-- 3. A-Frame 3D-Szene (Transparent) -->
    <!-- embedded deaktiviert den Fullscreen-Button, vr-mode-ui versteckt VR-Brillen-Icons -->
    <a-scene embedded vr-mode-ui="enabled: false" renderer="alpha: true; antialias: true;">
        
        <!-- Licht-Setup für die 3D-Objekte -->
        
        

        <!-- Virtuelle Kamera (Fixierter Blickpunkt, Handybewegung simuliert Raumschwenk) -->
        

        <!-- NAVI-PFAD: KÜCHE -->
        <!-- Startpunkt ist 0 0 0. Der Pfad verläuft flach leicht über dem Boden (y = -1.5) -->
        
            <!-- 1. Abschnitt: 3 Meter geradeaus (entlang der Z-Achse nach vorne = minus-z) -->
            <!-- Position ist die Mitte des Segments. Tiefe (depth) = Länge des Segments -->
            <a-box position="0 -1.5 -1.5" width="0.2" height="0.02" depth="3" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>
            
            <!-- 2. Abschnitt: 90 Grad links abbiegen für 7 Meter -->
            <!-- Startet bei z = -3. Geht nach links (minus-x). Mitte liegt bei x = -3.5, z = -3. Breite = Länge -->
            <a-box position="-3.5 -1.5 -3" width="7" height="0.02" depth="0.2" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>
            
            <!-- 3. Abschnitt: Wieder 90 Grad links abbiegen für 3 Meter -->
            <!-- Startet bei x = -7, z = -3. Geht zurück (plus-z). Mitte liegt bei x = -7, z = -1.5 -->
            <a-box position="-7 -1.5 -1.5" width="0.2" height="0.02" depth="3" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>
            
            <!-- 4. Abschnitt: Letztes Mal 90 Grad links für 3 Meter zum Ziel -->
            <!-- Startet bei x = -7, z = 0. Geht nach rechts (plus-x). Mitte liegt bei x = -5.5, z = 0 -->
            <a-box position="-5.5 -1.5 0" width="3" height="0.02" depth="0.2" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>

            <!-- ZIEL-FAHNE (Am Ende des Pfades bei x = -4, y = -1.5, z = 0) -->
            
                <!-- Fahnenmast -->
                <a-cylinder position="0 1 0" radius="0.03" height="2" color="#ffffff"></a-cylinder>
                <!-- Neon-Flagge (Animiert rotierend) -->
                <a-triangle position="0.3 1.7 0" vertex-a="0 0.3 0" vertex-b="0 -0.3 0" vertex-c="0.6 0 0" 
                            material="color: #ff0055; emissive: #ff0055; emissiveIntensity: 1; side: double"
                            animation="property: rotation; to: 0 360 0; loop: true; dur: 4000; easing: linear">
                </a-triangle>
                <!-- Pulsierender Ziel-Ring auf dem Boden -->
                <a-ring radius-inner="0.3" radius-outer="0.4" rotation="-90 0 0" position="0 0.05 0"
                        material="color: #ff0055; emissive: #ff0055; emissiveIntensity: 2; side: double"
                        animation="property: scale; to: 1.3 1.3 1.3; loop: true; dur: 1000; dir: alternate; easing: easeInOutQuad">
                </a-ring>
            
        


        <!-- NAVI-PFAD: BAD -->
        <!-- Beispielpfad: 2m geradeaus, dann 90 Grad rechts für 2m -->
        
            <!-- 2m geradeaus -->
            <a-box position="0 -1.5 -1" width="0.2" height="0.02" depth="2" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>
            <!-- Abknicken nach rechts für 2m -->
            <a-box position="1 -1.5 -2" width="2" height="0.02" depth="0.2" material="color: #00e5ff; emissive: #00e5ff; emissiveIntensity: 2; opacity: 0.8;"></a-box>
            
            <!-- Ziel-Markierung Bad -->
            <a-cone position="2 -1 0" radius-bottom="0.2" radius-top="0" height="0.5" material="color: #00e5ff; emissive: #00e5ff;"
                    animation="property: position; to: 2 -0.8 0; direction: alternate; loop: true; dur: 1000"></a-cone>
        

    </a-scene>

    <!-- 4. Logik-Skript für Kamera und Interaktion -->
    <script>
        // Automatisch den Zugriff auf die Rückseitenkamera anfordern
        const video = document.getElementById('camera-stream');
        
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ 
                video: { 
                    facingMode: "environment", // Erzwingt die rückseitige Hauptkamera am Handy
                    width: { ideal: 1280 },
                    height: { ideal: 720 }
                }, 
                audio: false 
            })
            .then(function(stream) {
                video.srcObject = stream;
            })
            .catch(function(err) {
                console.error("Kamerazugriff verweigert oder nicht unterstützt: ", err);
                alert("Bitte erlaube den Kamerazugriff, um das Mockup voll zu erleben.");
            });
        }

        // Navigations-Aktivierung
        function startNavigation(ziel) {
            // Overlay ausblenden
            document.getElementById('menu-overlay').classList.add('hidden');
            document.getElementById('reset-btn').style.display = 'block';

            // Alle Pfade unsichtbar machen
            document.getElementById('path-kueche').setAttribute('visible', 'false');
